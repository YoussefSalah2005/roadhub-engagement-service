# Engagement Service (S2). Copy to .env (git-ignored). No secrets here: secrets are in AWS Secrets Manager.
PORT=3002
NODE_ENV=development
SERVICE_NAME=engagement
CORS_ORIGINS=http://localhost:4566,http://localhost:8080
# Floci (not secrets: Floci accepts any test keys)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Where the other services are (or the internal gateway http://127.0.0.1:8081 when running replicas)
ROADMAP_URL=http://127.0.0.1:3001
ENGAGEMENT_URL=http://127.0.0.1:3002
ADMIN_URL=http://127.0.0.1:3003
# Which copy answered (shown in /health and the X-Instance-Id header). Default: engagement-<process id>.
# INSTANCE_ID=engagement-1
# Audit trail in CloudWatch Logs (/aws/ecs/roadhub-engagement). Set to off only for quick local tests.
# AUDIT_LOGS=on
# Notification worker (npm run worker, or the Lambda made by infra/services/08-lambda.sh)
# EMAIL_REDIRECT_TO=you@example.com   # demo without a verified domain: send every e-mail to this address
# WEBSITE_URL=http://localhost:8080   # link in the e-mails
