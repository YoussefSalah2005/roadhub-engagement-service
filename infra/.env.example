# Copy to infra/.env (git-ignored). Read only by infra/scripts/create-secrets.sh, which stores the
# values in AWS Secrets Manager (roadhub/resend). Never commit infra/.env, never paste the key in chat.
# This file is read by bash: put values with spaces or < > inside single quotes.
RESEND_API_KEY=
RESEND_FROM='RoadmapHub <onboarding@resend.dev>'
