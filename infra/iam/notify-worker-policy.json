{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadVotersAndMergeLinks",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-votes",
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-votes/index/*",
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-engagement-links",
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-engagement-links/index/*"
      ]
    },
    {
      "Sid": "RecordNotifications",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-notifications",
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-processed-messages"
      ]
    },
    {
      "Sid": "ConsumeNotifyQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:000000000000:roadhub-notify-queue"
      ]
    },
    {
      "Sid": "AlertOps",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": [
        "arn:aws:sns:us-east-1:000000000000:roadhub-ops-alerts"
      ]
    },
    {
      "Sid": "ReadResendAndServiceKeys",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:roadhub/resend-*",
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:roadhub/internal-*"
      ]
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/lambda/roadhub-notify-worker:*",
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/ecs/roadhub-engagement:*"
      ]
    }
  ]
}
