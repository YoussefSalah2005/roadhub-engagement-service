{
  "name": "roadhub-engagement-service",
  "version": "1.0.0",
  "private": true,
  "description": "RoadmapHub Engagement Service (S2): votes, comments, My votes, notifications. Owner: Youssef Mohamed Salah (239650)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "worker": "node workers/notificationWorker.js",
    "selfcheck": "node server.js --selfcheck",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "setup:aws": "bash infra/init-aws.sh",
    "setup:tables": "bash infra/services/01-dynamodb.sh",
    "setup:secrets": "bash infra/services/02-secrets-manager.sh",
    "zip:worker": "node scripts/zip-worker.js",
    "check": "bash infra/check-engagement.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2"
  }
}
